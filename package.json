{
  "name": "fisiofit-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @fisiofit/portal",
    "dev:site": "npm run dev -w @fisiofit/site",
    "build": "npm run build:site && npm run build:portal && node scripts/assemble-hostinger.mjs",
    "build:site": "npm run build -w @fisiofit/site",
    "build:portal": "npm run build -w @fisiofit/portal",
    "test": "npm run test --workspaces --if-present && node --test tests/platform.test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:test": "supabase test db"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "supabase": "^2.48.3",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "engines": {
    "node": ">=20"
  }
}
