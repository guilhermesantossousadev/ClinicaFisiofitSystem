<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /sistema/

  # A Hostinger pode resolver este subdiretório sem reaplicar o .htaccess raiz.
  RewriteCond %{HTTP_HOST} ^www\.clinicafisiofitsabara\.com$ [NC]
  RewriteRule ^ https://clinicafisiofitsabara.com%{REQUEST_URI} [R=301,L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://eeltguuoxpfttjznugla.supabase.co; connect-src 'self' https://eeltguuoxpfttjznugla.supabase.co wss://eeltguuoxpfttjznugla.supabase.co; frame-src 'none'; media-src 'self'; worker-src 'self'; manifest-src 'self'; upgrade-insecure-requests"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set X-Frame-Options "DENY"
</IfModule>
